install.packages("lehdr")
library(lehdr)
options(lehdr_use_cache = TRUE)
library(lehdr)
options(lehdr_use_cache = TRUE)
rac <- grab_lodes(state = "mn", year = 2003:2023, lodes_type = "rac",
job_type = "JT01", segment = "S000",
agg_geo = "block", use_cache = TRUE)
xwalk <- grab_crosswalk("mn")
mcd <- rac |>
left_join(select(xwalk, tabblk2020, ctycsub),
by = c("h_geocode" = "tabblk2020")) |>
group_by(year, ctycsub) |>
summarise(across(c(C000, starts_with("CNS")), sum), .groups = "drop")
