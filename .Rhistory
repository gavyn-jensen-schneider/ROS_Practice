n_sims <- 1000
avg_height <- rep(NA, n_sims)
max_height <- rep(NA, n_sims)
for (s in 1:n_sims){
N <- 10
male <- rbinom(N, 1, 0.48)
height <- ifelse(male==1, rnorm(N, 69.1, 2.9), rnorm(N, 63.7, 2.7))
