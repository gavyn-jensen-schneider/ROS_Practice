# Define the range of values and lambda (mean)
lambda <- 5
x <- 0:20
y <- dpois(x, lambda = lambda)
# Plot the Poisson distribution
plot(x, y, type = "h", lwd = 3, col = "blue",
main = "Poisson Distribution (lambda = 5)",
xlab = "Number of Events (x)",
ylab = "Probability")
points(x, y, pch = 16, col = "blue")
